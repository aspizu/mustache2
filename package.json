{
  "name": "mustache2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check .",
    "format": "oxfmt .",
    "prepare": "lefthook install",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-aspizuism": "^1.0.6",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  }
}
